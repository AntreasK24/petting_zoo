<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Human standing still in front of the robot (spawned at 1.05 0.51), facing it -->
    <actor name="standing_human">
      <skin>
        <filename>stand.dae</filename>
      </skin>
      <animation name="standing">
        <filename>stand.dae</filename>
      </animation>
      <script>
        <loop>true</loop>
        <trajectory id="0" type="standing">
          <waypoint>
            <time>0</time>
            <pose>3.0 0.5 0 0 0 3.14</pose>
          </waypoint>
          <waypoint>
            <time>10</time>
            <pose>3.0 0.5 0 0 0 3.14</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
