<?xml version="1.0"?>
<!-- Launch the mirte_apple_detector node with parameters from the YAML config.

     Override the config file at launch time with:
       ros2 launch mirte_apple_detector apple_detector.launch.xml \
           config_file:=/path/to/your.yaml
-->
<launch>
  <arg name="config_file"
       default="$(find-pkg-share mirte_apple_detector)/config/apple_detector.yaml"
       description="Full path to the parameter YAML file."/>

  <node pkg="mirte_apple_detector" exec="apple_detector" name="apple_detector" output="screen">
    <param from="$(var config_file)"/>
  </node>
</launch>
